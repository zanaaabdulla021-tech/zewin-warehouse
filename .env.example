# Neon PostgreSQL — copy both strings from the Neon console (Connection Details)
# Pooled connection (host contains "-pooler") — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/zewin_warehouse?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct connection — used by prisma migrate / db push
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/zewin_warehouse?sslmode=require"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# ── Notifications (optional — in-app notifications always work)
# Email via SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ZEWIN <no-reply@zewin.app>"
# WhatsApp Cloud API (Meta for Developers → WhatsApp → API Setup)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Optional approved template for messages outside the 24-hour window (body: {{1}} title, {{2}} text)
WHATSAPP_TEMPLATE=""
WHATSAPP_TEMPLATE_LANG="en"
